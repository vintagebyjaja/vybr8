# ─────────────────────────────────────────────────────────────
# VYBR8 environment variables
# Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_* values are exposed to the browser. Everything else is server-only.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "demo" enables mock providers and demo-data badges; "production" requires real providers
NEXT_PUBLIC_DATA_MODE=demo

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Used by webhooks, ranking jobs and admin tasks only.
SUPABASE_SECRET_KEY=

# Maps: "mock" | "mapbox" | "google"
MAP_PROVIDER=mock
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# AI: "none" | "openai"
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=

# Billing: "mock" | "stripe"
BILLING_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_MAX_MONTHLY=
STRIPE_PRICE_MAX_YEARLY=

# Delivery / reservations: "links" (business-entered outbound links) until partner access exists
DELIVERY_PROVIDER=links
RESERVATION_PROVIDER=links

# Observability (optional)
ANALYTICS_PROVIDER=none
ERROR_REPORTER=console
LOG_LEVEL=info

# Ranking job protection (random 32+ char string, used by the scheduled recompute endpoint)
CRON_SECRET=
